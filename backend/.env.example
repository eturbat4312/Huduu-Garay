GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Google token-ийг зөвшөөрөх client ID-нууд. Олон бол таслалаар тусгаарлана.
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com

# Django
DEBUG=False
SECRET_KEY=generate-a-strong-random-key
ALLOWED_HOSTS=tanaid-honoy.mn,www.tanaid-honoy.mn
CSRF_TRUSTED_ORIGINS=https://tanaid-honoy.mn,https://www.tanaid-honoy.mn
CORS_ALLOWED_ORIGINS=https://tanaid-honoy.mn,https://www.tanaid-honoy.mn

# PostgreSQL
DB_NAME=huduu
DB_USER=huduu_user
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432

# Email
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# QPay Merchant V2
QPAY_ENABLED=False
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_AUTH_URL=https://merchant.qpay.mn/v2/auth/token
QPAY_CLIENT_ID=your-qpay-client-id
QPAY_CLIENT_SECRET=your-qpay-client-secret
QPAY_INVOICE_CODE=your-qpay-invoice-code
QPAY_CALLBACK_URL=https://www.tanaid-honoy.mn/api/payments/qpay/callback/
QPAY_TIMEOUT_SECONDS=30
QPAY_TOKEN_LEEWAY_SECONDS=60

# Facebook Login — backend-only secrets; enable after Meta App setup and testing.
FACEBOOK_ENABLED=False
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v24.0
FACEBOOK_REDIRECT_URI=https://www.tanaid-honoy.mn/api/auth/facebook/callback/
FRONTEND_URL=https://www.tanaid-honoy.mn
