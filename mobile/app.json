{
  "expo": {
    "name": "Танайд Хоноё",
    "slug": "tanaid-honoy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tanaidhonoy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "mn.tanaidhonoy.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Байршлыг газрын зураг дээр харуулахад ашиглана.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Байршлыг газрын зураг дээр харуулахад ашиглана."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "mn.tanaidhonoy.app",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Иргэний үнэмлэхний зураг болон selfie оруулахын тулд зургийн цомогт хандах зөвшөөрөл хэрэгтэй."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Байршлыг газрын зураг дээр харуулахад ашиглана."
        }
      ],
      [
        "react-native-maps",
        {
          "googleMapsApiKey": ""
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f1d5927-4c1e-4cee-8454-afa04b810cd8"
      }
    }
  }
}
